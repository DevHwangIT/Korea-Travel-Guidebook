<body class="places-map-app">
  <div class="places-map-shell">
    <header class="places-map-topbar">
      <a href="../../index.html" class="places-map-topbar__back" data-i18n="common.backMain">← Main Guide</a>
      <div class="places-map-topbar__brand">
        <a href="../../index.html" class="places-map-topbar__logo" data-i18n="common.brand">Korea Travel Guide</a>
        <h1 class="places-map-topbar__title" data-i18n="misc.transportTitle">명소</h1>
      </div>

      <div class="places-map-topbar__tools" role="toolbar" aria-label="Map tools">
        <div class="places-map-regions" data-places-regions role="group" aria-label="Regions">
          <button type="button" class="places-map-chip is-active" data-places-region="all" data-i18n="transport.regionAll">전체</button>
          <button type="button" class="places-map-chip" data-places-region="seoul" data-i18n="transport.regionSeoul">서울</button>
          <button type="button" class="places-map-chip" data-places-region="gyeonggi" data-i18n="transport.regionGyeonggi">경기</button>
          <button type="button" class="places-map-chip" data-places-region="incheon" data-i18n="transport.regionIncheon">인천</button>
          <button type="button" class="places-map-chip" data-places-region="gangwon" data-i18n="transport.regionGangwon">강원</button>
          <button type="button" class="places-map-chip" data-places-region="busan" data-i18n="transport.regionBusan">부산</button>
          <button type="button" class="places-map-chip" data-places-region="gyeongju" data-i18n="transport.regionGyeongju">경주</button>
          <button type="button" class="places-map-chip" data-places-region="gyeongsang" data-i18n="transport.regionGyeongsang">경상</button>
          <button type="button" class="places-map-chip" data-places-region="jeolla" data-i18n="transport.regionJeolla">전라</button>
          <button type="button" class="places-map-chip" data-places-region="jeju" data-i18n="transport.regionJeju">제주</button>
        </div>
        <button type="button" class="places-map-reset" data-places-map-reset data-i18n="transport.mapReset">한반도 전체 보기</button>
        <button type="button" class="places-map-list-toggle" data-places-list-toggle aria-expanded="false" data-i18n="transport.listToggle">목록</button>
      </div>

      <nav class="lang-switch places-map-lang" aria-label="Language"></nav>
    </header>

    <div class="places-map-viewport">
      <div
        id="places-korea-map"
        class="places-korea-map"
        role="application"
        data-i18n-attr="aria-label:transport.mapAlt"
        aria-label="한반도 명소 지도"
      ></div>

      <p class="places-map-hint" data-places-hint data-i18n="transport.mapHelp">
        핀을 눌러 명소를 살펴보세요
      </p>

      <aside class="places-map-legend is-collapsed" data-places-legend aria-label="Place type filters">
        <button
          type="button"
          class="places-map-legend__toggle"
          data-places-filter-toggle
          aria-expanded="false"
          aria-controls="places-filter-body"
          data-i18n="transport.filterToggle"
        >필터</button>
        <div class="places-map-legend__body" id="places-filter-body" data-places-legend-body>
        <div class="places-map-legend__head">
          <p class="places-map-legend__title" data-i18n="transport.filterTitle">유형 필터</p>
          <button type="button" class="places-map-legend__all" data-places-type-all data-i18n="transport.filterAll">전체</button>
        </div>
        <p class="places-map-legend__help" data-i18n="transport.filterHelp">표시할 유형을 선택하세요</p>

        <section class="places-map-legend__group" aria-labelledby="places-filter-group-places">
          <h3 class="places-map-legend__group-title" id="places-filter-group-places" data-i18n="transport.filterGroupPlaces">명소</h3>
          <ul class="places-map-legend__list" role="group" aria-label="Sightseeing">
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="city" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--city" aria-hidden="true"></span>
                <span data-i18n="transport.legendCity">도시</span>
              </label>
            </li>
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="nature" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--nature" aria-hidden="true"></span>
                <span data-i18n="transport.legendNature">자연</span>
              </label>
            </li>
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="heritage" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--heritage" aria-hidden="true"></span>
                <span data-i18n="transport.legendHeritage">문화재</span>
              </label>
            </li>
          </ul>
        </section>

        <section class="places-map-legend__group" aria-labelledby="places-filter-group-transit">
          <h3 class="places-map-legend__group-title" id="places-filter-group-transit" data-i18n="transport.filterGroupTransit">교통</h3>
          <ul class="places-map-legend__list" role="group" aria-label="Transit">
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-metro-filter="metro">
                <span class="places-map-legend__swatch places-map-legend__swatch--metro" aria-hidden="true"></span>
                <span data-i18n="transport.legendMetro">지하철</span>
              </label>
            </li>
            <li class="places-map-legend__item places-map-legend__item--sub" data-places-metro-sub hidden>
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-metro-filter="metroLines" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--metro-line" aria-hidden="true"></span>
                <span data-i18n="transport.legendMetroLines">노선</span>
              </label>
            </li>
            <li class="places-map-legend__item places-map-legend__item--sub" data-places-metro-sub hidden>
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-metro-filter="metroStations" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--metro-station" aria-hidden="true"></span>
                <span data-i18n="transport.legendMetroStations">역</span>
              </label>
            </li>
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="airport" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--airport" aria-hidden="true"></span>
                <span data-i18n="transport.legendAirport">공항</span>
              </label>
            </li>
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="port" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--port" aria-hidden="true"></span>
                <span data-i18n="transport.legendPort">항구</span>
              </label>
            </li>
          </ul>
        </section>

        <section class="places-map-legend__group" aria-labelledby="places-filter-group-convenience">
          <h3 class="places-map-legend__group-title" id="places-filter-group-convenience" data-i18n="transport.filterGroupConvenience">편의</h3>
          <ul class="places-map-legend__list" role="group" aria-label="Convenience">
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="locker" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--locker" aria-hidden="true"></span>
                <span data-i18n="transport.legendLocker">물품보관함</span>
              </label>
            </li>
            <li class="places-map-legend__item">
              <label class="places-map-legend__label">
                <input type="checkbox" class="places-map-legend__check" data-places-type-filter="info" checked>
                <span class="places-map-legend__swatch places-map-legend__swatch--info" aria-hidden="true"></span>
                <span data-i18n="transport.legendInfo">안내·대사관</span>
              </label>
            </li>
          </ul>
        </section>
        </div>
      </aside>

      <aside class="places-map-panel" data-places-panel aria-hidden="true">
        <p class="places-map-panel__empty" data-places-panel-empty data-i18n="transport.mapCaption">
          등록된 명소를 지도에서 살펴보세요
        </p>
        <div class="places-map-panel__body" data-places-panel-body hidden>
          <div class="places-map-panel__handle" aria-hidden="true"></div>
          <div class="places-map-panel__toolbar">
            <span class="places-map-panel__region" data-places-panel-region></span>
            <button type="button" class="places-map-panel__close" data-places-panel-close data-i18n="transport.mapClose" aria-label="Close">닫기</button>
          </div>
          <div class="places-map-panel__cover-wrap" data-places-panel-cover-wrap hidden>
            <img class="places-map-panel__cover" data-places-panel-cover alt="" loading="lazy" decoding="async">
          </div>
          <h2 class="places-map-panel__title" data-places-panel-title></h2>
          <p class="places-map-panel__info-badge" data-places-panel-info hidden data-i18n="transport.infoBadge">외국인 유용 정보 (명소 아님)</p>
          <p class="places-map-panel__info-badge places-map-panel__info-badge--locker" data-places-panel-locker hidden data-i18n="transport.lockerBadge">물품보관 · 시간·빈칸은 앱/현장에서 확인</p>
          <p class="places-map-panel__info-badge places-map-panel__info-badge--port" data-places-panel-port hidden data-i18n="transport.portBadge">항구 · 여객·크루즈 거점</p>
          <p class="places-map-panel__desc" data-places-panel-desc></p>
          <p class="places-map-panel__how" data-places-panel-how></p>

          <div class="places-map-panel__detail" data-places-panel-detail hidden>
            <p class="places-map-panel__address" data-places-panel-address-wrap hidden>
              <a
                class="places-map-panel__address-link"
                data-places-panel-address
                href="#"
                target="_blank"
                rel="noopener noreferrer"
              ></a>
            </p>
            <div class="places-map-panel__how-block" data-places-panel-how-block hidden>
              <h3 class="places-map-panel__how-title" data-i18n="transport.howLabel">가는 방법</h3>
              <p class="places-map-panel__how-full" data-places-panel-how-full></p>
            </div>
            <div
              class="content-body places-map-panel__content"
              data-content-body
              data-places-panel-body-mount
              data-body-path=""
              hidden
            ></div>
            <div class="places-map-panel__map-wrap" data-places-panel-map-wrap hidden>
              <iframe
                class="places-map-panel__map-embed"
                data-places-panel-embed
                title="map"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
                src="about:blank"
              ></iframe>
            </div>
          </div>

          <div class="places-map-panel__actions">
            <button
              type="button"
              class="places-map-panel__expand"
              data-places-panel-expand
              data-i18n="transport.mapOpenDetail"
            >자세히 보기</button>
            <button
              type="button"
              class="places-map-panel__collapse"
              data-places-panel-collapse
              data-i18n="transport.mapCollapseDetail"
              hidden
            >간단히 보기</button>
          </div>
        </div>
      </aside>

      <div class="places-map-drawer" data-places-drawer hidden aria-hidden="true">
        <div class="places-map-drawer__head">
          <h2 data-i18n="transport.listTitle">명소 목록</h2>
          <button type="button" class="places-map-drawer__close" data-places-drawer-close data-i18n="transport.mapClose">닫기</button>
        </div>
        <p class="places-map-drawer__note" data-i18n="transport.listHelp">목록에서 고르면 지도가 이동합니다.</p>
        <ul class="places-map-drawer__list" data-places-drawer-list></ul>
      </div>
    </div>

    <p class="places-map-source" data-i18n="transport.mapSource"></p>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="../../data/places/places-coords.js?v=20260815114500"></script>
  <script src="../../data/metro/metro-data.js?v=20260815114500"></script>
  <script src="../../data/metro/stations-data.js?v=20260815114500"></script>
  <script src="../../js/site-config.js?v=20260815114500"></script>
  <script src="../../i18n/messages.js?v=20260815114500"></script>
  <script src="../../js/i18n.js?v=20260815114500"></script>
  <script src="../../js/seo.js?v=20260815114500"></script>
  <script src="../../js/content-body.js?v=20260815114500"></script>
  <script src="../../js/places-map.js?v=20260815114500"></script>
</body>
</html>
